#include<iostream>
using namespace std;
template<typename T>
void mySwap(T &a, T &b)
 { 
 T temp = a;
  a = b;
   b = temp; 
   }
int main()
{
int emp1 = 101,emp2 = 102;
mySwap(emp1,emp2);
cout<<"Employee IDs after swap:"<<emp1<<" "<<emp2<<endl;
int room1 = 201,room = 205;
mySwap(room1,room2);
cout<<"Room  Numbers after swap:"<<room1<<" "<<room2<<endl;
float p1 = 1.2f, p2 = 2.5f;
mySwap(p1, p2);
cout << "Task Priorities after swap: " << p1 << " " << p2 << endl;

return 0;
}
